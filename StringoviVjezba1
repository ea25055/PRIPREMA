public class Zadaci1 {
   
	public static String obradaLaptop(String l) {
		String[]niz = l.split(";");
		double cijena = Double.parseDouble(niz[1]);
		int kolicina = Integer.parseInt(niz[2]);
		double ukupnaCijena = cijena * kolicina;
		
		return "Naziv: " + niz[0] + " " + "Cijena: " + cijena + " " + "Kolicina: "
		+ kolicina + " " + "Ukupna cijena: " + ukupnaCijena + " " + "eura";
	}
	
	   public static String Student (String student) {
		   String oznaka = student.substring(0, 2);
		   String godina = student.substring(2,6);
		   String indeks = student.substring(7);
		   
		   return "Oznaka: " + oznaka + " " + "Godina: " + godina + " "
				   + "Broj indexa: " + indeks + " ";
	   }
	
