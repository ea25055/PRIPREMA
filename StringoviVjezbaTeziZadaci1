	   public static String obradiLet(String let) {
		   String [] niz = let.split(";");
		   String oznakaLeta =niz[0];
		   String polazakAerodrom = niz[1];
		   String dolazakAerodrom = niz[2];
		   String vrijemePolaska = niz[3];
		   String vrijemeDolaska = niz [4];
		   String duzinaKm = niz[5];
		   String satiPolazak = niz[3].substring(0,2);
		   String minutiPolazak= niz[3].substring(3);
		   String satiDolazak = niz[4].substring(0,2);
		   String minutiDolazak = niz[4].substring(3);
		   int sP =Integer.parseInt(satiPolazak);
		   int mP =Integer.parseInt(minutiPolazak);
		   int sD=Integer.parseInt(satiDolazak);
		   int mD =Integer.parseInt(minutiDolazak);
		   int P = sP * 60 + mP;
		   int D = sD * 60 + mD;
		   int trajanje = D - P;
		   
		   return "\nOznaka leta: " + oznakaLeta + " " + "\nAerodrom polaska: " + polazakAerodrom + " " +
		   "\nAerodrom dolaska: " + dolazakAerodrom + " " + 
		   "\n Vrijeme polaska i dolaska: " +
		   vrijemePolaska + " " 
		   + vrijemeDolaska + " " + "\nTrajanje leta u minutima: " + trajanje + " " + "minuta";
		   
	   }
	
