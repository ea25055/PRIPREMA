	   String temp = niz[1].substring(2);
	   String vlaznost = niz[2].substring(2);
	   String pritisak = niz[3].substring(2);
	   double tempKelvin = Double.parseDouble(temp);
	   double tempCelz = tempKelvin - 273.15;
