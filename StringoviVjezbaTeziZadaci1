	public static String obradiStudenta(String student) {
		String []niz = student.split(";");
		String oznaka = student.substring(0,2);
		String godinaUpisa = student.substring(2,6);
		String brojIndexa = student.substring(7,10);
		String ime = niz[1];
		String prosjek = niz[2];
		int godinaUpisaint = Integer.parseInt (godinaUpisa);
		int prosloGodina = 2026 - godinaUpisaint;
		    return "Oznaka studenta: " + oznaka + " " + "\nGodina upisa: " + godinaUpisa + " " +
				"\nBroj indeksa: " + brojIndexa + " " + "\nIme: " + ime + " " + "\nProsjek: " + prosjek + " " +
				"\nOd upisa studenta proslo je: " + prosloGodina + " " + "godina";
		}
	
	  public static String obradiAutomobil (String auto) {
		String [] niz = auto.split("\\|");
		String oznaka = niz[0];
		String marka = niz[1];
		String godinaProizvodnje = niz[2];
		String zapreminaMotora = niz[3];
		String snaga = niz[4];
		double konjskaSnaga =Double.parseDouble(snaga);
		double kilovati =Math.round(konjskaSnaga * 0.7355 * 100.00) / 100.0;
