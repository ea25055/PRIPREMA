				godinaProizvodnje + " " + "\n Zapremina motora: " + zapreminaMotora + " " + "\n Konjska snaga: " +
	      konjskaSnaga + " " + "\n Snaga u kilovatima: " + kilovati  ;
	  }
	   public static String obradaSenzora (String senzor) {
		   String[]niz  = senzor.split("#");
