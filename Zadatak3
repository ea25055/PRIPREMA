 }
       public static double ukupnaZarada(ArrayList<Clan>lista) {
    	   double ukupno = 0.00;
    	   for (Clan c:lista) {
    		   ukupno = ukupno + c.izracunajClanarinu();
    	   } return ukupno;
       }
        public static Clan najvecaClanarina(ArrayList<Clan>lista) {
        	Clan najvecaClanarina = lista.get(0);
        	for(Clan c:lista) {
        		if(c.izracunajClanarinu()>najvecaClanarina.izracunajClanarinu())	{
        			najvecaClanarina = c;
        		}
         	}
        	return najvecaClanarina;
        }
      public static double prosjekTreninga (ArrayList<Clan>lista) {
    	  double ukupno = 0;
    	  for (Clan c:lista) {
    		 ukupno = ukupno + c.getBrojTreninga();
    	  }
    	  double prosjekk = ukupno/lista.size();
        return prosjekk;
      }
      
      
      
