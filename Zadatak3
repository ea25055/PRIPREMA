
public class Clan {
 private int clanskiBroj;
 private String imePrezime;
 private int godine;
 private int brojTreninga;
 private boolean trener;
 private boolean sauna;
 public static double osnovnaClanarina;
 
 public Clan(int clanskiBroj, String imePrezime, int godine, int brojTreninga, boolean trener, boolean sauna) {
	super();
	this.setClanskiBroj(clanskiBroj);
	this.imePrezime = imePrezime;
	this.setGodine (godine);
	this.brojTreninga = brojTreninga;
	this.trener = trener;
	this.sauna = sauna;
 }
 public Clan() {
	super();
 }
 public String toString() {
	return "Clan [clanskiBroj=" + clanskiBroj + ", imePrezime=" + imePrezime + ", godine=" + godine + ", brojTreninga="
			+ brojTreninga + ", trener=" + trener + ", sauna=" + sauna + "]";
 }
 public int getClanskiBroj() {
	return clanskiBroj;
 }
 public void setClanskiBroj(int clanskiBroj) {
	 if (clanskiBroj >= 100 && clanskiBroj <= 999) {
	this.clanskiBroj = clanskiBroj;
	 }
 }
 public String getImePrezime() {
	return imePrezime;
 }
 public void setImePrezime(String imePrezime) {
	this.imePrezime = imePrezime;
 }
 public int getGodine() {
	return godine;
 }
 public void setGodine(int godine) {
	 if(godine>=16 && godine<=80) {
		this.godine=godine; 
	 } 
 }
 public int getBrojTreninga() {
	return brojTreninga;
 }
 public void setBrojTreninga(int brojTreninga) {
	this.brojTreninga = brojTreninga;
 }
 public boolean isTrener() {
	return trener;
 }
 public void setTrener(boolean trener) {
	this.trener = trener;
 }
 public boolean isSauna() {
	return sauna;
 }
 public void setSauna(boolean sauna) {
	this.sauna = sauna;
 }
 
 public double izracunajClanarinu() {
	 double clanarina = osnovnaClanarina + getBrojTreninga()*2;
	 if(isTrener()==true) {
		 clanarina = clanarina + 30.00;
	 } if (isSauna()==true) {
			 clanarina = clanarina + 10;
	 }if(getGodine()<18) {
				 clanarina = clanarina -  clanarina * 0.20;
			 }
		
	 return clanarina;
 }
    public String infoOClanu() {
    	return toString();
    }
}

