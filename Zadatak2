
public class Knjiga {
  private int sifra;
  private String naziv;
  private String autor;
  private int brojStrana;
  private int godinaIzdanja;
  private boolean dostupna;
  public static double cijenaPoStranici;
  public Knjiga(int sifra, String naziv, String autor, int brojStrana, int godinaIzdanja, boolean dostupna) {
	super();
	this.setSifra(sifra);
	this.naziv = naziv;
	this.autor = autor;
	this.setBrojStrana(brojStrana);
	this.godinaIzdanja = godinaIzdanja;
	this.dostupna = dostupna;
  }
  public Knjiga() {
	super();
  }
  public int getSifra() {
	return sifra;
  }
  public void setSifra(int sifra) {
	  if (sifra >= 1000 && sifra <= 9999) {
	  this.sifra = sifra;
	  } else {
		  this.sifra = 0;
	  }
  }
  public String getNaziv() {
	return naziv;
  }
  public void setNaziv(String naziv) {
	this.naziv = naziv;
  }
  public String getAutor() {
	return autor;
  }
  public void setAutor(String autor) {
	this.autor = autor;
  }
  public int getBrojStrana() {
	return brojStrana;
  }
  public void setBrojStrana(int brojStrana) {
	  if (brojStrana>0) {
		 this.brojStrana = brojStrana;
	  }
  }
  public int getGodinaIzdanja() {
	return godinaIzdanja;
  }
  public void setGodinaIzdanja(int godinaIzdanja) {
	this.godinaIzdanja = godinaIzdanja;
  }
  public boolean isDostupna() {
	return dostupna;
  }
  public void setDostupna(boolean dostupna) {
	this.dostupna = dostupna;
  }
 
  public int  dajStarost() {
	  int starost = 2026 - getGodinaIzdanja();
	  return starost;
  }
    public double izracunajCijenu() {
    	double cijena = getBrojStrana()*cijenaPoStranici;
    	if (getGodinaIzdanja()<2010) {
    		cijena = cijena - cijena * 0.20;
    	}
    	return cijena;
    }
    
    public String infoOKnjizi() {
    	return toString();
    }
    
  public String toString() {
	return "Knjiga [sifra=" + sifra + ", naziv=" + naziv + ", autor=" + autor + ", brojStrana=" + brojStrana
			+ ", godinaIzdanja=" + godinaIzdanja + ", dostupna=" + dostupna + "]";
  }
  
}
import java.util.ArrayList;
