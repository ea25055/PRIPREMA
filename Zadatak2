				System.out.println(k);
			}
		}
	}
	public static double ukupnaVrijednost (ArrayList<Knjiga>lista) {
		double ukupno = 0.00;
		for (Knjiga k:lista) {
		 ukupno = ukupno + k.izracunajCijenu();
		}
		return ukupno;
	}
	 public static Knjiga najstarijaKnjiga(ArrayList<Knjiga>lista) {
		Knjiga najstarijaKnjiga = lista.get(0);
		 for (Knjiga k:lista) {
			 if(k.getGodinaIzdanja() < najstarijaKnjiga.getGodinaIzdanja()) {
				 najstarijaKnjiga = k;
				  }
			 }
		 return najstarijaKnjiga;
	 }
	
	 public static double prosjecnaCijena(ArrayList<Knjiga>lista) {
		 double prosjek =ukupnaVrijednost(lista)/lista.size();
		 return prosjek;
		 
	 }
	 
	 
	 
	 
