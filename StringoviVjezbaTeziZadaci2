         public static String obradiTransakciju (String banka) {
        	 String[]niz = banka.split(";");
        	 String brojTransakcije = niz[0];
        	 String brojRacuna = niz[1];
        	 String iznosTransakcije = niz[2];
        	 String valuta = niz[3];
        	 String datum = niz[4];
        	 double iznos = Double.parseDouble(iznosTransakcije);
        	 double provizija = iznos * 0.015;
        	 provizija =Math.round(provizija * 100) / 100.00;
        	 
        	 return "\nBroj transakcije: " + brojTransakcije +
        			 "\nBroj racuna: " + brojRacuna +
        			 "\nIznos transakcije: " + iznosTransakcije + " " + valuta +
        			 "\nDatum: " + datum +
        			 "\nIznos provizije: " + provizija;
        	 
         }
