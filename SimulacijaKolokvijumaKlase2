public class Apartman {
    private int sifra;
    private String grad;
    private int brojNoci;
    private double cijenaPoNoci;
    private boolean dorucak;
    public static double boravisnaTaksa;
	public Apartman(int sifra, String grad, int brojNoci, double cijenaPoNoci, boolean dorucak) {
		super();
		this.setSifra (sifra);
		this.grad = grad;
		this.setBrojNoci (brojNoci);
		this.cijenaPoNoci = cijenaPoNoci;
		this.dorucak = dorucak;
	}
	public Apartman() {
		super();
	}
	public String toString() {
		return "Apartman [sifra=" + sifra + ", grad=" + grad + ", brojNoci=" + brojNoci + ", cijenaPoNoci="
				+ cijenaPoNoci + ", dorucak=" + dorucak + "]";
	}
	public int getSifra() {
		return sifra;
	}
	public void setSifra(int sifra) {
		if (sifra <= 100 && sifra <= 999) {
		} this.sifra = sifra;
	this.sifra = 0;
			
	}
	public String getGrad() {
		return grad;
	}
	public void setGrad(String grad) {
		this.grad = grad;
	}
	public int getBrojNoci() {
		return brojNoci;
	}
	public void setBrojNoci(int brojNoci) {
		if (brojNoci >= 1 && brojNoci <= 30) {
		}this.brojNoci = brojNoci;
		this.brojNoci = 1;
	}
	public double getCijenaPoNoci() {
		return cijenaPoNoci;
	}
	public void setCijenaPoNoci(double cijenaPoNoci) {
		this.cijenaPoNoci = cijenaPoNoci;
	}
	public boolean isDorucak() {
		return dorucak;
	}
	public void setDorucak(boolean dorucak) {
		this.dorucak = dorucak;
	}
    
    public double izracunajCijenu() {
    	double cijena = 0.00;
    	cijena = brojNoci * cijenaPoNoci + boravisnaTaksa;
    	if (dorucak == true) {
    		cijena = cijena + 20.00;
    	}
    	if (brojNoci >= 7) {
    		cijena = cijena - 0.10;
    	}
    	return cijena;
    }
	
	
}
